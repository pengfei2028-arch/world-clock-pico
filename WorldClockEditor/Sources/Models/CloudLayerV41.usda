    def "Materials"
    {
        def Material "CloudSurface" (
            customData = {
                bool applyToneMapping = 1
                string blendingMode = "TRANSPARENT"
                string cullingMode = "BACK"
                bool depthTest = 1
                bool depthWrite = 0
                string materialType = "SHADER_GRAPH"
                double opacityThreshold = 0
                string shaderGraphGuid = "ad1187f7-2916-4a35-9532-202610210041"
            }
        )
        {
            token outputs:mtlx:surface.connect = </CloudAsset/Materials/CloudSurface/Surface.outputs:out>

            def Shader "CloudMask"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @../Textures/clouds_8k.jpg@
                float outputs:out
            }

            def Shader "CloudDensity"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </CloudAsset/Materials/CloudSurface/CloudMask.outputs:out>
                float inputs:in2 = 0.65
                float outputs:out
            }

            def Shader "Surface"
            {
                uniform token info:id = "ND_pbr_surfaceshader"
                color3f inputs:baseColor = (1, 1, 1)
                float inputs:clearCoat = 0
                float inputs:metallic = 0
                float inputs:opacity.connect = </CloudAsset/Materials/CloudSurface/CloudDensity.outputs:out>
                float inputs:reflectance = 0.1
                float inputs:roughness = 0.9
                token outputs:out
            }
        }
    }
}

