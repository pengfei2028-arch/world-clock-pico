<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorldClockSpatialTheme"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:theme="@style/Theme.WorldClockSpatialTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DefaultStage Configuration -->

            <!-- The unique name/id of the Stage -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="WorldClockEarthMixedV08" />

            <!-- Stage style at launch
                 "0": StageStyle.Automatic, a system default setting, set to Mixed currently (default)
                 "1": StageStyle.Mixed — displays both virtual content and the real environment at full intensity (100% each)
                 "2": StageStyle.Progressive — allows adjusting the balance between virtual and real environments (0–100%)
                    At 0: immersion = 0,full real environment, no virtual content
                    At 100: immersion = 100,full virtual content, no real environment
                 "3": StageStyle.Full — displays only virtual content (100%)
             -->
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="1" />

            <!-- Mixed keeps VST visible. The forward feathered cap is an app entity. -->


        </activity>

        <activity
            android:name=".platform.FootprintPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.WorldClockSpatialTheme" />

        <!-- SDK 6.1.9: hit-test opt-out is limited to the separate, display-only status attachment. -->
        <meta-data android:name="pico.spatial.use_experimental_api" android:value="1" />
        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
